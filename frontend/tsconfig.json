{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "wailsjs/go/**/*.ts",
    "wailsjs/runtime/**/*.d.ts",
    "vite.config.ts",
    "svelte.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "wailsjs/runtime/runtime.js",
    "wailsjs/go/**/*.js"
  ]
}
